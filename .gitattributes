# 统一换行，避免跨平台协作时整文件 diff
* text=auto

# 明确 EOL
*.sh    text eol=lf
*.ps1   text eol=crlf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.html  text eol=lf
*.txt   text eol=lf

# 二进制（不要做任何转换）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.wav   binary
*.mp3   binary
*.ico   binary

# 减少上游文件的 diff 噪音
package-lock.json  linguist-generated
demo/index.html    linguist-generated
